# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web app config (safe to expose in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Service account JSON as a single line, used to verify session cookies.
# On Firebase App Hosting leave this empty; Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server-only, optional. Set to 1 ONLY on a plain-http staging host so the session
# cookie is sent without the Secure flag. Never set this in production.
SESSION_COOKIE_INSECURE=
