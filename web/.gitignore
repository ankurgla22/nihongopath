# See https://github.com/github/gitignore for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files: every .env variant is ignored; only the template is tracked.
.env
.env.*
!.env.example

# service account keys must never be committed
*service-account*.json
*serviceAccount*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/
.firebaserc.local

# Enrichment working batches (inputs are regenerated by scripts/enrich-batches.mjs prep)
.enrich/
