        {
          "kind": "callout",
          "title": "4, 7 and 9",
          "text": "Both readings exist; よん / なな / きゅう are the default in counting and with most counters. し / しち / く are used in fixed items: しがつ (April), しちがつ (July), くがつ (September), よじ (4 o'clock, uses よ), しちじ (7 o'clock), くじ (9 o'clock).",
          "tone": "accent"
        }
      ]
    },
