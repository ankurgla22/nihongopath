{
  "apphosting": {
    "backendId": "web",
    "rootDir": "/",
    "alwaysDeployFromSource": true,
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      "tests",
      "*.log",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true }
  }
}
