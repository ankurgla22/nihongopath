{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate:content && npm run typecheck && npm run lint && vitest run",
    "import:content": "tsx scripts/import-study-materials.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "gen:curriculum": "tsx scripts/generate-curriculum.ts",
    "gen:questions": "tsx scripts/generate-questions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "test:ssr": "node tests/run-ssr.mjs",
    "test:e2e": "node tests/e2e-smoke.mjs",
    "test:seo": "node tests/seo-audit.mjs",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
